# Cabeceras que Cloudflare agrega a los archivos del sitio (Workers Static Assets). No se publica como archivo.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Archivos de Vite con hash en el nombre: cambian de nombre en cada versión, se pueden guardar un año.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
